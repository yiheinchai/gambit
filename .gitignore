# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wasm binaries (large, installed from npm via postinstall)
/public/stockfish/*.wasm
/public/onnx/*.wasm
/public/models/*.onnx

# training data, models, and venv (large)
/training/data/
/training/models/
/training/.venv/

# python cache
__pycache__/
*.pyc

# claude code
/.claude/
